# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage

# Environments
.env
env/
venv/
.venv/

# Node (if any frontend build in future)
node_modules/

# Media and course material are never committed (spec §12, AC-8)
samples/
# score_session.py writes cut clips and extracted frames here
out/
*.jpg
*.jpeg
*.mp4
*.mov
*.mkv
*.avi
*.heic
*.pdf
# The cached demo sample lives here (tools/make_demo_sample.py writes it).
# Only non-video assets are committed: a git-push deploy ships only what is in
# the tree, but videos stay off-repo (spec §12). Point SAMPLE_CLIP_URL at a
# hosted MP4, or SAMPLE_RESULT_URL at the whole JSON, to put the replay back.
!demo_sample/.gitkeep
!demo_sample/sample.json
!demo_sample/*.jpg

# OS files
.DS_Store
Thumbs.db

# Sideline Pro: the local SQLite store (tools/dev_server_fake_paypal.py, a local run)
.data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage

# Environments
.env
env/
venv/
.venv/

# Node (if any frontend build in future)
node_modules/

# Media and course material are never committed (spec §12, AC-8)
samples/
# score_session.py writes cut clips and extracted frames here
out/
*.jpg
*.jpeg
*.mp4
*.mov
*.mkv
*.avi
*.heic
*.pdf
# The one exception: the cached demo sample (tools/make_demo_sample.py writes
# it here). It is the clip the public demo serves to every visitor anyway,
# picked for that, and a git-push deploy (Heroku's buildpack path) ships only
# what is in the tree. Keep it small (one lift, under ~10 MB), and the .gitkeep
# so the Dockerfile's COPY has something to copy before a sample exists.
!demo_sample/.gitkeep
!demo_sample/sample.json
!demo_sample/*.mp4

# OS files
.DS_Store
Thumbs.db

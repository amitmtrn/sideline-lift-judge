NEBIUS_API_KEY=your_nebius_token_factory_key_here
# Optional: override the base URL if Token Factory environment differs
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Models (two-stage pipeline)
# Vision/perception (images -> observations):
# NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
# Vision model image limit per request
# NEBIUS_VISION_MAX_IMAGES=10
# Judge/reasoning (observations -> JSON score). The code default is Ultra with
# a Super fallback; the Docker image overrides both (see below).
# NEBIUS_JUDGE_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Second judge, used when the primary errors, times out, or never returns valid
# JSON. Set it to an empty value to disable the fallback.
# NEBIUS_JUDGE_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# Judge token budget. Thinking is disabled, but keep headroom so a reasoning
# model that ignores that hint still finishes the JSON instead of truncating.
# NEBIUS_JUDGE_MAX_TOKENS=2048

# Server configuration
PORT=8000
HOST=0.0.0.0
# Upload ceiling in megabytes; 0 disables the check. Phone clips of one lift are
# well under this once trimmed. The deploys set 60 (Heroku's router gives a
# request 30 s, upload included).
MAX_UPLOAD_MB=200
# How long a finished job and its annotated replay are kept before deletion.
JOB_TTL_SECONDS=1800
# Wall clock one scoring run may take, model calls and replay included. On
# everywhere (600 s unless set); 0 turns it off. The deploys set 120.
# JOB_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Public demo: access and spend caps. See "Running the public demo" in the
# README; the account-side caps (prepaid credits only, a key made just for
# the demo) come first. In a local checkout every cap below is OFF until set,
# so local runs, the CLIs and the tests are untouched. The Docker image and
# deploy/heroku-web.sh — the public demo — set them ON with the values shown;
# a container's environment (this file via --env-file or compose, a config
# var on Heroku) overrides those, so uncomment to change one.
# ---------------------------------------------------------------------------
# How visitors get in. `open`: no code anywhere — the caps below are what
# bounds the spend, and the app refuses to start in this mode if any of them
# is unset or zero. `link`: the code rides in the URL (?code=…) the page is
# opened from and is never typed; a request without it gets a friendly 401 and
# the sample. `code`: typed on the first screen (the default when unset).
# Switch between them with the variable alone — no code change, no rebuild.
# ACCESS_MODE=code
# The code for link and code modes. No default: it is the secret. Judges get
# the link with ?code=... in it; the page stores the code and sends it as the
# X-Access-Code header, which is checked before the upload is read.
# Comma-separate several codes so one can be revoked.
DEMO_ACCESS_CODE=change-me
# Kill switch: true serves the sample result only, with no model call and no
# redeploy. Flip it back to false (or unset it) to resume.
# DEMO_DISABLED=false
# Model calls per day, all visitors together. A single-lift clip is three
# calls (triage, observation, judge); a retry adds one; a session clip adds
# one triage per window. Then "Today's free demo limit is used up".
# DEMO_DAILY_LIMIT=150
# Where midnight is for that budget: an IANA zone name. UTC unless set; the
# deploys say Asia/Jerusalem, where the judging is.
# DEMO_DAY_TIMEZONE=Asia/Jerusalem
# The last share of the day's budget that an address which has already scored
# a clip today may not touch, so one heavy user cannot lock out a judge who
# arrives in the evening. 20 unless set; 0 turns it off.
# DEMO_DAILY_RESERVE_PERCENT=20
# Model calls per visitor address per rolling hour (about four clips).
# DEMO_IP_HOURLY_LIMIT=12
# Who may tell the app the visitor's address via X-Forwarded-For: addresses,
# CIDR ranges, `private` (loopback, RFC 1918, link-local — a container network
# or a proxy on the same host), or `*` (whatever reaches the port; only when
# nothing but your proxy can, as on Heroku). Unset, the header is ignored and
# the socket's peer is the visitor — so behind a proxy everyone would share one
# allowance. deploy/docker-compose.yml sets `private` for Caddy; Heroku gets `*`.
# The first entry of the header is never believed: it is the client's to forge.
# TRUSTED_PROXIES=private
# Scoring runs in flight at once; the rest are told they are next and the page
# retries by itself after a minute.
# MAX_CONCURRENT_JOBS=1
# Longest window scored at a time, in seconds. The cap is on the trimmed
# window, not the upload, so a long gallery clip trimmed to one lift is fine.
# MAX_CLIP_SECONDS=15
# Lift windows one upload may score (a "Find them" clip, or a clip the tracker
# sees two rises in); the rest are listed as skipped. The run's cost is
# estimated from the windows before the first model call and refused whole if
# it would not fit what is left of the hour or the day.
# MAX_LIFTS_PER_CLIP=2
# Frames per lift ceiling (8-16). At 10 or fewer every lift is one vision call.
# MAX_FRAMES=10
# The cached sample: a result scored once with tools/make_demo_sample.py and
# served from disk at no cost, so a judge still sees a full result after the
# budget is spent, or while DEMO_DISABLED is on. The image bakes demo_sample/
# in at /app/demo_sample.
# DEMO_SAMPLE_DIR=demo_sample
# The image's judge: Nemotron 3 Super, with NO fallback to Ultra, so a failed
# judge call fails instead of escalating to the expensive model. Keep the
# default (Ultra) for your own recorded run; the page footer and every result
# card name the judge that actually answered.
# NEBIUS_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_JUDGE_FALLBACK_MODEL=
